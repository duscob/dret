    "benchmark_args": true,
    "args": "--data=data"
  },
  "common": {
    "subdir": "idx",
    "cmd": "bm_build_items",
    "benchmark_args": true,
    "args": "--data=data"
  },
  "repair-da": {
    "subdir": "idx",
    "cmd": "repair-prefix/src/repair/bal/irepair",
